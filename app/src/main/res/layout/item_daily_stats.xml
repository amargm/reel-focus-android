<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:paddingVertical="10dp" android:paddingHorizontal="4dp">
    <TextView android:id="@+id/date_text" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:text="Nov 29" android:textColor="@color/md_theme_on_surface" android:textSize="12sp"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3"
        android:orientation="vertical">
        <TextView android:id="@+id/sessions_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="5/5 sessions" android:textColor="@color/md_theme_on_surface" android:textSize="12sp"/>
        <TextView android:id="@+id/time_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="1h 40m" android:textColor="@color/md_theme_on_surface_variant" android:textSize="11sp"/>
        <TextView android:id="@+id/extensions_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="3 extensions" android:textColor="@color/md_theme_on_surface_variant" android:textSize="11sp"/>
    </LinearLayout>
</LinearLayout>