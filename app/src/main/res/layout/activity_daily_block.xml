<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/wellness_bg"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">
        <FrameLayout android:id="@+id/block_orb" android:importantForAccessibility="no"
            android:layout_width="156dp" android:layout_height="156dp" android:layout_marginBottom="22dp">
            <View android:layout_width="136dp" android:layout_height="136dp" android:layout_gravity="center"
                android:background="@drawable/wellness_orb"/>
            <View android:layout_width="92dp" android:layout_height="92dp" android:layout_gravity="center"
                android:translationX="27dp" android:translationY="-20dp" android:background="@drawable/wellness_orb"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                android:text="○" android:textSize="52sp" android:textColor="@color/wellness_ink"/>
        </FrameLayout>
        <TextView android:id="@+id/block_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Your focus time is complete" android:textSize="28sp" android:textColor="@color/wellness_ink"
            android:gravity="center" android:layout_marginBottom="12dp"/>
        <TextView android:id="@+id/block_session_info" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Sessions today: 5 of 5" android:textSize="12sp" android:textColor="@color/wellness_lime"
            android:background="@drawable/wellness_status_pill" android:paddingHorizontal="16dp"
            android:paddingVertical="8dp" android:layout_marginBottom="18dp"/>
        <TextView android:id="@+id/block_message" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="15sp" android:textColor="@color/wellness_muted" android:gravity="center"
            android:lineSpacingMultiplier="1.5" android:layout_marginBottom="30dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/home_button"
            style="@style/Widget.ReelFocus.Button.Filled" android:layout_width="match_parent" android:layout_height="58dp"
            android:text="Return to Today" android:textSize="15sp" android:textAllCaps="false"
            app:cornerRadius="29dp" app:backgroundTint="@color/wellness_dark" android:textColor="#FFFFFF"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/open_settings_button"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent"
            android:layout_height="50dp" android:text="Review my boundaries" android:textAllCaps="false"
            android:textColor="@color/wellness_muted" app:cornerRadius="25dp"/>
    </LinearLayout>
</ScrollView>