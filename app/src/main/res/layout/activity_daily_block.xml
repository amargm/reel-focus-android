<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="28dp"
    android:background="@color/md_theme_background">
    <FrameLayout android:layout_width="190dp" android:layout_height="190dp" android:layout_marginBottom="24dp">
        <View android:layout_width="160dp" android:layout_height="160dp" android:layout_gravity="center"
            android:background="@drawable/calm_orb_clay"/>
        <View android:layout_width="108dp" android:layout_height="108dp" android:layout_gravity="center"
            android:translationX="30dp" android:translationY="-24dp" android:background="@drawable/calm_orb_sage"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
            android:text="○" android:textSize="58sp" android:textColor="@color/md_theme_on_background"/>
    </FrameLayout>
    <TextView android:id="@+id/block_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Rest for today" android:textSize="28sp" android:textColor="@color/md_theme_on_background"
        android:gravity="center" android:layout_marginBottom="12dp"/>
    <TextView android:id="@+id/block_session_info" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Sessions today: 5 of 5" android:textSize="12sp" android:textColor="@color/md_theme_primary"
        android:background="@drawable/m3_state_layer_background" android:paddingHorizontal="16dp"
        android:paddingVertical="8dp" android:layout_marginBottom="18dp"/>
    <TextView android:id="@+id/block_message" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="15sp" android:textColor="@color/md_theme_on_surface_variant" android:gravity="center"
        android:lineSpacingMultiplier="1.5" android:layout_marginBottom="34dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/home_button"
        style="@style/Widget.ReelFocus.Button.Filled" android:layout_width="match_parent" android:layout_height="58dp"
        android:text="Return home" android:textSize="15sp" android:textAllCaps="false" app:cornerRadius="29dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/open_settings_button"
        style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent"
        android:layout_height="50dp" android:text="Review my boundaries" android:textAllCaps="false"
        android:textColor="@color/md_theme_on_surface_variant" app:cornerRadius="25dp"/>
</LinearLayout>