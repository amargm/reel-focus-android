<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="28dp"
    android:background="@color/md_theme_background">
    <FrameLayout android:importantForAccessibility="no" android:layout_width="190dp" android:layout_height="190dp" android:layout_marginBottom="22dp">
        <View android:layout_width="160dp" android:layout_height="160dp" android:layout_gravity="center"
            android:background="@drawable/calm_orb_sage"/>
        <View android:layout_width="104dp" android:layout_height="104dp" android:layout_gravity="center"
            android:translationX="34dp" android:translationY="-24dp" android:background="@drawable/calm_orb_lilac"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
            android:text="◌" android:textSize="62sp" android:textColor="@color/md_theme_on_background"/>
    </FrameLayout>
    <TextView android:id="@+id/interrupt_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="A moment to pause" android:textSize="28sp" android:textColor="@color/md_theme_on_background"
        android:gravity="center" android:layout_marginBottom="12dp"/>
    <TextView android:id="@+id/interrupt_message" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="15sp" android:textColor="@color/md_theme_on_surface_variant" android:gravity="center"
        android:lineSpacingMultiplier="1.5" android:layout_marginBottom="14dp"/>
    <TextView android:id="@+id/session_info" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Session 1 of 5" android:textSize="12sp" android:textColor="@color/md_theme_primary"
        android:background="@drawable/m3_state_layer_background" android:paddingHorizontal="16dp"
        android:paddingVertical="8dp" android:layout_marginBottom="10dp"/>
    <TextView android:id="@+id/hint_text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="@color/md_theme_on_surface_variant" android:gravity="center"
        android:paddingHorizontal="8dp" android:layout_marginBottom="26dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/stop_button"
        style="@style/Widget.ReelFocus.Button.Filled" android:layout_width="match_parent" android:layout_height="58dp"
        android:text="Continue gently" android:textSize="15sp" android:textAllCaps="false"
        app:cornerRadius="29dp" app:backgroundTint="@color/md_theme_primary"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/extend_button"
        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent"
        android:layout_height="54dp" android:text="Take five more minutes" android:textAllCaps="false"
        android:textSize="14sp" app:cornerRadius="27dp" app:strokeColor="@color/md_theme_outline"
        android:layout_marginTop="10dp"/>
</LinearLayout>